# Little Wonder World - environment variables (placeholders only, never commit real values)
# Copy this file to .env.local for local development.
# The app works with NONE of these set (local demo mode, no AI).

# ---------- PUBLIC (sent to the browser; never put secrets here) ----------
# Supabase project URL and public "publishable" (anon) key. Safe for the browser because Row Level Security protects the data.
# With both set, parents can sign in on the Account page to store progress in the cloud. Leave empty for on-device storage only.
# Find them in the Supabase dashboard: Project Settings -> API. NEVER put the service_role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------- SERVER-ONLY SECRETS (never prefix with NEXT_PUBLIC_) ----------
# Turn the server-side AI conversation endpoint on. Anything other than "true" keeps it off.
AI_ENABLED=false
# Which provider adapter to use: "anthropic" (implemented) or "local" (built-in, no key needed).
AI_PROVIDER=local
AI_API_KEY=
AI_MODEL=
# Max AI replies per client IP per hour (basic abuse protection) and per-request timeout.
AI_RATE_LIMIT_PER_HOUR=60
AI_TIMEOUT_MS=8000

# Only for server-side admin scripts / migrations. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
